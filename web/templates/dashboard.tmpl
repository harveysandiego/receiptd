{{define "content"}}
<h2>Dashboard</h2>

<section class="summary">
<div class="card">
<h3>Printers</h3>
<p class="metric" id="printers-online">{{.PrintersOnline}} / {{.PrinterCount}} online</p>
<p id="printers-status-message">{{.StatusMessage}}</p>
</div>

<div class="card">
<h3>Assets</h3>
<p class="metric">{{.AssetCount}} stored</p>
</div>

<div class="card">
<h3>Queue</h3>
<ul>
<li id="queue-pending">Pending: {{.QueuePending}}</li>
<li id="queue-running">Running: {{.QueueRunning}}</li>
<li id="queue-done">Done: {{.QueueDone}}</li>
<li id="queue-failed">Failed: {{.QueueFailed}}</li>
<li id="queue-cancelled">Cancelled: {{.QueueCancelled}}</li>
</ul>
<p class="metric" id="queue-total">{{.QueueTotal}} total</p>
</div>
</section>
{{end}}

{{define "scripts"}}<script src="/static/dashboard.js" defer></script>{{end}}
