{{define "content"}}
<h2>Preview</h2>

{{if .Message}}
<p class="validation-message">{{.Message}}</p>
{{end}}

<form method="post" action="/preview" class="preview-form">
<label>Printer <input type="text" name="printer" value="{{.Printer}}" list="printer-options" required></label>
<datalist id="printer-options">{{range .Printers}}<option value="{{.}}">{{end}}</datalist>
<label>Receipt JSON <textarea name="receipt" class="json-editor" rows="12" required>{{.ReceiptJSON}}</textarea></label>
<button type="submit">Generate preview</button>
</form>

<p id="stale-notice" class="stale-notice" hidden>Preview may be out of date — regenerate to see your latest changes.</p>

<div class="preview-area">
{{if .ImageDataURI}}
<img src="{{.ImageDataURI}}" alt="Receipt preview">
{{else}}
<p>No preview generated yet. Submit the form above to render one.</p>
{{end}}
</div>
{{end}}

{{define "scripts"}}<script src="/static/builder.js" defer></script>{{end}}
