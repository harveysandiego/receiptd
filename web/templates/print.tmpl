{{define "content"}}
<h2>Print</h2>

<p>Submit a receipt to print it now. This creates a print job on the selected printer's queue.</p>

{{if .JobID}}
<p class="confirmation-message">Receipt accepted: print job {{.JobID}} created and queued. The queue will print it.</p>
{{end}}

{{if .Message}}
<p class="validation-message">{{.Message}}</p>
{{end}}

<form method="post" action="/print" class="print-form">
<input type="hidden" name="csrf_token" value="{{.CSRFToken}}">
<label>Printer <input type="text" name="printer" value="{{.Printer}}" list="printer-options" required></label>
<datalist id="printer-options">{{range .Printers}}<option value="{{.}}">{{end}}</datalist>
<label>Receipt JSON <textarea name="receipt" class="json-editor" rows="12" required>{{.ReceiptJSON}}</textarea></label>
<button type="submit">Print</button>
</form>
{{end}}

{{define "scripts"}}<script src="/static/builder.js" defer></script>{{end}}
